# === Claude / Anthropic ===
ANTHROPIC_API_KEY=sk-ant-...

# === Audio STT (pick one) ===
AUDIO_STT_PROVIDER=deepgram          # deepgram | whisper
DEEPGRAM_API_KEY=
OPENAI_API_KEY=                      # only needed if STT=whisper or TTS=openai

# === Audio TTS (pick one) ===
AUDIO_TTS_PROVIDER=cartesia          # cartesia | openai | elevenlabs
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# === Telephony (for outbound calls) ===
TELEPHONY_PROVIDER=twilio            # twilio | vonage | telnyx
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+61...           # Australian number

# === Output ===
OUTPUT_MODE=both                     # s3 | webhook | both
S3_BUCKET_NAME=buyer-briefs
S3_REGION=ap-southeast-2
WEBHOOK_URL=https://your-crm.example.com/api/briefs

# === General ===
LOG_LEVEL=INFO
ENVIRONMENT=development              # development | staging | production
