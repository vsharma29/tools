# ElevenLabs Configuration
ELEVENLABS_API_KEY=your_api_key_here
ELEVENLABS_AGENT_ID=your_agent_id_here
ELEVENLABS_VOICE_ID=your_voice_id_here
AGENT_PHONE_NUMBER=+1234567890
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_LLM_MODEL=claude-3-5-sonnet
ELEVENLABS_LLM_TEMPERATURE=0.3
ELEVENLABS_VOICE_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_SPEECH_SPEED=1.0
AGENCY_NAME=Your Buyer's Agency
MAX_CONVERSATION_DURATION=900
ENABLE_RECORDING=true
RETENTION_DAYS=90

# Web Dashboard
SECRET_KEY=your-secret-key-change-in-production
PORT=5000

# Twilio (for SMS Trigger)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
AUTHORIZED_NUMBERS=+61400000001,+61400000002

# Google Sheets Integration
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEET_NAME=Prospects
