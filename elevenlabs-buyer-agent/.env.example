# ============================================
# ElevenLabs Buyer Agent Configuration
# ============================================

# === ElevenLabs API (Required) ===
ELEVENLABS_API_KEY=xi_...

# === Voice Configuration ===
# Use a custom voice ID or leave empty for default
# Find voice IDs at: https://elevenlabs.io/voices
ELEVENLABS_VOICE_ID=
# TTS model: eleven_turbo_v2_5 (fast) | eleven_multilingual_v2 (quality)
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
# Voice stability (0-1, higher = more consistent)
ELEVENLABS_VOICE_STABILITY=0.5
# Similarity boost (0-1, higher = closer to original voice)
ELEVENLABS_SIMILARITY_BOOST=0.75
# Speech speed (0.7-1.3, 1.0 = normal)
ELEVENLABS_SPEECH_SPEED=1.0

# === LLM Configuration ===
# Supported: claude-3-5-sonnet, gpt-4o, gemini-2.0-flash
ELEVENLABS_LLM_MODEL=claude-3-5-sonnet
# Temperature (0-1, lower = more deterministic)
ELEVENLABS_LLM_TEMPERATURE=0.3

# === Twilio Integration (for phone calls) ===
# Leave empty to skip Twilio setup
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+61...

# === Webhook Configuration ===
# URL to receive completed buyer briefs
WEBHOOK_URL=https://your-crm.example.com/api/briefs
# Secret for webhook signature verification
WEBHOOK_SECRET=

# === S3 Storage (optional backup) ===
S3_BUCKET_NAME=buyer-briefs
S3_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# === Agent Settings ===
# Agency name shown in greetings
AGENCY_NAME=Your Buyer's Agency
# Max conversation duration in seconds (default 900 = 15 min)
MAX_CONVERSATION_DURATION=900
# Enable conversation recording
ENABLE_RECORDING=true
# Data retention days (-1 for unlimited)
RETENTION_DAYS=90
