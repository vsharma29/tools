{
  "version": 2,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/submit",
      "dest": "/api/submit.py"
    },
    {
      "src": "/api/briefs",
      "dest": "/api/briefs.py"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
